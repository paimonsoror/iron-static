# Godot
.godot/
.import/
*.tmp

# Build outputs
/build/
*.apk
*.aab
*.idsig
reports/

# Android Gradle build template: reinstalled by tools/setup_android_template.ps1
# (contains >100 MB engine AARs; plugin config lives in addons/, not here)
/android/build/
/android/.build_version
.gradle/

# Secrets and signing (never commit)
*.keystore
*.jks
secrets.local.json

# Python
.venv/
__pycache__/

# Misc
*.bak
!tests/fixtures/**/*.bak
Thumbs.db

# Godot temp copies of GDExtension libraries (left behind by parallel-run collisions)
~lib*.dll
~lib*.so

# Stray files from Windows paths whose backslashes were stripped (C:/dev/tower/build/x.png -> devtowerbuildx.png)
/devtower*

# Codex site (GitHub Pages): local venv and build output
site/.venv/
site/public/

# Play publishing credentials (tools/play_publish.py): keys live OUTSIDE the repo; these are belt and braces
*service-account*.json
*service_account*.json
*serviceaccount*.json
play-*.json
client_secret*.json
*.p12
*.pfx
*.pem
