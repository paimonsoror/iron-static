class_name SimWorld
extends RefCounted
## The whole simulation state and the fixed-order tick (M1 shared contracts; TECH_ARCHITECTURE 2.1).
## Pure RefCounted. Systems are static classes in `src/sim/systems/` that read and write this object.
##
## PRE-PROVISIONED STATE (declared in M1-07 so later tasks do not edit this file). Field: type: owner.
##   rng_spawn, rng_crit, rng_loot, rng_effects, rng_draft: Rng: spawn plan/angles M1-08, crit M1-10,
##       loot (reserved), effects (reserved), draft (M2); streams via Rng.derive(seed, name); all hashed.
##   plan: WavePlanState: type_index/spawn_tick/angle_idx/spawned packed arrays (capacity n_cap + 8), count,
##       cursor, built, wave: M1-08 (builds and consumes; SimWorld.step calls plan.begin at wave_tick 0).
##   laser_charge: int: M1-10, fixed-point shot accumulator (1000 per cycle_rate unit per tick).
##   next_wave_is_boss: bool: M1-13 writes (true when wave + 1 is a boss wave), UI reads; set at init.
##   query_buf: PackedInt32Array (size = enemy capacity): scratch for grid.query_radius, any system; not hashed.
##   type_is_boss: PackedByteArray, type_behavior: PackedByteArray (BEH_*): per enemy type index, any system.
##   economy: EconomyState (scrap, data_run BigNum; wave_kill_scrap, scrap_frac floats): M2-05; hashed.
##   tick_scrap, tick_data: float: per-tick kill reward accumulators (LaserSystem adds, EconomySystem stage 5b
##       converts and zeroes them).
##   run_levels: PackedInt32Array (per config.upgrades row), visible: PackedByteArray (UnlockRules from
##       config.best_wave_s1): M2-06; hashed. Mutated only by UpgradeSystem via command_buy.
##   run.spawn_throttled: int: M1-08. run.ended: bool: set only by end_run().
##   alive_normal_count() / alive_boss_count(): helpers for the alive caps, M1-08.
## Helpers for systems: spawn_enemy (M1-08, debug), end_run (M1-14), bolt_ttl_ticks (M1-12),
##   is_boss_wave, alive_normal_count, alive_boss_count.
## Step order and the ownership of end_run: see `step`.

const DT: float = 1.0 / 30.0  ## seconds per tick (= 1 / Ticks.TICK_RATE)
const BEH_MELEE: int = 0
const BEH_RANGED: int = 1
const BEH_MELEE_BOSS: int = 2
const GRID_CELL_M: float = 4.0  ## (impl) spatial grid cell size in meters
const PLAN_SLACK: int = 8  ## plan capacity = n_cap + PLAN_SLACK (one boss plus margin)
const ENEMY_CAP_MARGIN: int = 64  ## store capacity above the alive caps
const BOLT_EXTRA_TTL_S: float = 1.0  ## bolt ttl = arena crossing time plus this

var config: SimConfig
var tick: int = 0
var wave: int = 1
var wave_tick: int = 0
var level_hp: int = 1
var level_atk: int = 1
var enemies: EnemyStore
var projectiles: ProjectileStore
var grid: SpatialGrid
var cinder: CinderState
var stats: StatBlock
var economy: EconomyState
var run_levels: PackedInt32Array
var visible: PackedByteArray
var tick_scrap: float = 0.0
var tick_data: float = 0.0
var run: RunStats
var events: SimEvents
var plan: WavePlanState

var rng_spawn: Rng
var rng_crit: Rng
var rng_loot: Rng
var rng_effects: Rng
var rng_draft: Rng

var laser_charge: int = 0
var next_wave_is_boss: bool = false
var query_buf: PackedInt32Array
var type_is_boss: PackedByteArray
var type_behavior: PackedByteArray

var _streams: Array[Rng] = []


func _init(cfg: SimConfig) -> void:
	config = cfg
	var t: SimTuning = cfg.tuning
	var cap: int = maxi(EnemyStore.DEFAULT_CAPACITY, t.alive_cap_normal + t.alive_cap_boss + ENEMY_CAP_MARGIN)
	enemies = EnemyStore.new(cap)
	projectiles = ProjectileStore.new()
	grid = SpatialGrid.new(t.arena_radius, GRID_CELL_M)
	run_levels = PackedInt32Array()
	if run_levels.resize(cfg.upgrades.size()) != OK:
		push_error("SimWorld: run_levels resize failed")
	run_levels.fill(0)
	visible = UnlockRules.visible(cfg.upgrades, cfg.best_wave_s1)
	stats = StatBlock.from_resolver(cfg.upgrades, run_levels)
	economy = EconomyState.new()
	economy.scrap = BigNum.from_float(t.start_scrap)
	cinder = CinderState.new()
	cinder.setup(stats.hull_integrity, cfg.debug_invulnerable)
	run = RunStats.new()
	events = SimEvents.new()
	plan = WavePlanState.new(t.n_cap + PLAN_SLACK)
	rng_spawn = Rng.derive(cfg.seed_value, "spawn")
	rng_crit = Rng.derive(cfg.seed_value, "crit")
	rng_loot = Rng.derive(cfg.seed_value, "loot")
	rng_effects = Rng.derive(cfg.seed_value, "effects")
	rng_draft = Rng.derive(cfg.seed_value, "draft")
	_streams = [rng_spawn, rng_crit, rng_loot, rng_effects, rng_draft]
	query_buf = PackedInt32Array()
	if query_buf.resize(cap) != OK:
		push_error("SimWorld: query_buf resize failed")
	_init_type_tables(cfg)
	level_hp = 1 + t.sector_offset_step * (cfg.sector - 1)
	level_atk = level_hp
	next_wave_is_boss = is_boss_wave(wave + 1)
	plan.begin(wave)
	events.push(SimEventKind.WAVE_STARTED, wave, 0)


## Advances the simulation by one tick. A finished run ignores further calls.
## Order (authoritative): 1 wave clock and plan start, 2 spawn, 3 movement, 4 grid rebuild, 5 laser,
## 5b economy (BigNum conversion), 6 enemy attack, 7 projectiles, 8 regeneration and exposure,
## 9 end-of-wave resolution at wave_tick 720, 10 death check (end_run), 11 tick += 1.
## ExposureSystem may also call end_run (idempotent).
func step() -> void:
	if run.ended:
		return
	events.tick = tick
	if wave_tick == 0:
		plan.begin(wave, true)  # carry unspawned entries over (GDD 02 section 6: never dropped)
	SpawnSystem.step(self)
	MovementSystem.step(self)
	grid.rebuild(enemies)
	LaserSystem.step(self)
	EconomySystem.apply_tick(self)
	EnemyAttackSystem.step(self)
	ProjectileSystem.step(self)
	ExposureSystem.step(self)
	wave_tick += 1
	if wave_tick >= Ticks.WAVE_TICKS:
		WaveEndSystem.step(self)
		wave += 1
		wave_tick = 0
		events.push(SimEventKind.WAVE_STARTED, wave, 0)
	if not cinder.alive:
		end_run()
	tick += 1


## Buys up to `count` levels (1, 10, 100, -1 = Max) of upgrade row `upgrade_index`; returns levels bought.
## The single entry point for purchases: callers apply commands before `step()` (M2-07 logs them here).
func command_buy(upgrade_index: int, count: int) -> int:
	if run.ended:
		return 0
	return UpgradeSystem.buy(self, upgrade_index, count)


func is_over() -> bool:
	return run.ended


## Ends the run once: sets death_wave, pushes RUN_ENDED(wave, death_cause). Later calls do nothing.
func end_run() -> void:
	if run.ended:
		return
	run.ended = true
	run.death_wave = wave
	events.push(SimEventKind.RUN_ENDED, wave, run.death_cause)


func state_hash() -> String:
	return StateHash.compute(self)


func rng_streams() -> Array[Rng]:
	return _streams


## True when `w` is a boss wave (`w % boss_interval == 0`).
func is_boss_wave(w: int) -> bool:
	var interval: int = config.tuning.boss_interval
	return interval > 0 and w % interval == 0


func alive_boss_count() -> int:
	var n: int = 0
	for t: int in config.enemies.size():
		if type_is_boss[t] != 0:
			n += enemies.count_type(t)
	return n


func alive_normal_count() -> int:
	return enemies.alive_count - alive_boss_count()


## Ticks a bolt lives: time to cross the arena at bolt speed plus one second.
func bolt_ttl_ticks() -> int:
	var t: SimTuning = config.tuning
	return ceili(t.arena_radius / t.lancer_bolt_speed * float(Ticks.TICK_RATE)) + Ticks.from_seconds(BOLT_EXTRA_TTL_S)


## Shared spawn helper (SpawnSystem and debug spawns). hp = hp0 * G_hp(level_hp) * hp_mult and
## dmg = d0 * G_atk(level_atk) * dmg_mult; pushes ENEMY_SPAWNED(index, type). Returns the index or -1 if
## the store is full (callers must handle -1). BOSS_SPAWNED is the caller's job.
func spawn_enemy(type_index: int, x: float, y: float) -> int:
	var i: int = enemies.alloc(type_index)
	if i < 0:
		return -1
	var t: SimTuning = config.tuning
	var def: EnemyDef = config.enemies[type_index]
	var g_hp: float = Curves.g_growth(level_hp, t.g_hp_1, t.g_hp_2, t.g_hp_3, t.phase_1_end, t.phase_2_end)
	var g_atk: float = Curves.g_growth(level_atk, t.g_atk_1, t.g_atk_2, t.g_atk_3, t.phase_1_end, t.phase_2_end)
	enemies.pos_x[i] = x
	enemies.pos_y[i] = y
	enemies.prev_x[i] = x
	enemies.prev_y[i] = y
	enemies.radius[i] = def.radius
	enemies.speed[i] = def.speed
	enemies.hp[i] = t.hp0 * g_hp * def.hp_mult
	enemies.max_hp[i] = enemies.hp[i]
	enemies.dmg[i] = t.d0 * g_atk * def.dmg_mult
	enemies.born_wave[i] = wave
	enemies.level_hp[i] = level_hp
	events.push(SimEventKind.ENEMY_SPAWNED, i, type_index)
	return i


func debug_spawn_enemy(type_index: int, x: float, y: float) -> int:
	return spawn_enemy(type_index, x, y)


## Spawns an enemy bolt. Velocity is in meters per second (systems move by v * DT). Returns -1 if full.
func debug_spawn_bolt(x: float, y: float, vx: float, vy: float, damage: float) -> int:
	var i: int = projectiles.alloc()
	if i < 0:
		return -1
	projectiles.pos_x[i] = x
	projectiles.pos_y[i] = y
	projectiles.vel_x[i] = vx
	projectiles.vel_y[i] = vy
	projectiles.damage[i] = damage
	projectiles.ttl_ticks[i] = bolt_ttl_ticks()
	return i


func _init_type_tables(cfg: SimConfig) -> void:
	type_is_boss = PackedByteArray()
	type_behavior = PackedByteArray()
	if type_is_boss.resize(EnemyStore.MAX_TYPES) != OK or type_behavior.resize(EnemyStore.MAX_TYPES) != OK:
		push_error("SimWorld: type table resize failed")
	for t: int in cfg.enemies.size():
		var def: EnemyDef = cfg.enemies[t]
		type_is_boss[t] = 1 if def.group == "boss" else 0
		match def.behavior_id:
			"ranged":
				type_behavior[t] = BEH_RANGED
			"melee_boss":
				type_behavior[t] = BEH_MELEE_BOSS
			_:
				type_behavior[t] = BEH_MELEE
