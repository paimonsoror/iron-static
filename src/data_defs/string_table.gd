class_name StringTable
extends Resource
## UI strings generated from data/strings_en.csv by the importer: `keys[i]` maps to `texts[i]`.
## Shipped in the export because data/ is `.gdignore`d and its CSVs never reach the APK.

@export var keys: PackedStringArray = PackedStringArray()
@export var texts: PackedStringArray = PackedStringArray()
